# Discovery booking uses the Google Calendar API only — no Appointment Schedule / booking page URL.
# Optional: keep button copy in sync with server (Netlify: DISCOVERY_SLOT_MINUTES=30)
# VITE_DISCOVERY_SLOT_MINUTES=30

# --- Google Calendar API (Netlify + local .env for functions — not VITE_*) ---
# Which calendar to use: your main calendar email, "primary", or a dedicated outreach calendar ID.
# The site reads busy times here and creates 30-min events with Google Meet on book.
GOOGLE_CALENDAR_ID=

# Option A — OAuth (recommended for personal Gmail + Google Meet links)
# Web client: add redirect URI http://localhost:3333/oauth/callback then run:
#   node scripts/google-oauth-refresh-token.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Option B — Service account (share your calendar with the service account email, Make changes to events)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_IMPERSONATE=   # Workspace domain-wide delegation only

# Booking rules (optional)
# DISCOVERY_TIMEZONE=Europe/London
# DISCOVERY_SLOT_MINUTES=30
# DISCOVERY_HOUR_START=9
# DISCOVERY_HOUR_END=21
# DISCOVERY_HOUR_END_MINUTE=30
# DISCOVERY_WEEKDAYS=1,2,3,4,5,6,7
# DISCOVERY_MIN_NOTICE_HOURS=4
# DISCOVERY_HORIZON_DAYS=28

# --- Cold-outreach checkout (Netlify Functions — never VITE_*) ---
# Porkbun domain availability (server-side only)
# PORKBUN_API_KEY=
# PORKBUN_SECRET_API_KEY=

# Stripe Checkout (start with sk_test_…; creating a session does not charge)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # /api/stripe-webhook — subscribe to:
#   checkout.session.completed, invoice.paid, invoice.payment_failed,
#   customer.subscription.updated, customer.subscription.deleted

# Checkout email (Google Workspace / Gmail — recommended)
# Same OAuth client as Calendar. Run: node scripts/google-oauth-gmail-refresh-token.mjs
# Enable Gmail API in Google Cloud; sign in as nathan@taylor-marriott.com when prompted.
# Billing notices use this same mailer (netlify/functions/_shared/mailer.js).
# GOOGLE_GMAIL_REFRESH_TOKEN=
# CHECKOUT_FROM_EMAIL=nathan@taylor-marriott.com
# CHECKOUT_FROM_NAME=Taylor-Marriott
# CHECKOUT_REPLY_TO=nathan@taylor-marriott.com
# CHECKOUT_ALERT_EMAIL=nathan@taylor-marriott.com
# Optional legacy: SENDGRID_API_KEY (used only if Gmail OAuth is not set)

# Post-payment domain step (/api/domain-fulfil). Both switches OFF unless exactly 1.
# NETLIFY_AUTH_TOKEN=
# DOMAIN_PURCHASE_LIVE=0   # 1 = really register at Porkbun (live-mode payments only)
# DOMAIN_CONNECT_LIVE=0    # 1 = really set Porkbun DNS + Netlify custom domain

# Final fallback only if live FX + blob cache unavailable (Frankfurter / open.er-api.com used first)
# CHECKOUT_USD_TO_GBP=0.79
# DOMAIN_INCLUDED_MAX_GBP=20   # Year-1 domain included in £299 when yearly retail is at or under this (GBP). Higher prices are shown and the excess is added today.

# Billing jobs (default dry-run). 1 = live.
# BILLING_ACTIONS_LIVE=0
# BILLING_NOTIFY_LIVE=0
# BILLING_NOTIFY_CLIENTS=0
# BILLING_CRON_SECRET=   # required before BILLING_ACTIONS_LIVE=1. Sent as Authorization: Bearer.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+447378961404

# Inbound SMS and WhatsApp (/api/twilio-inbound). 1 = email nathan. Anything else logs only.
# INBOUND_NOTIFY_LIVE=0

# Outreach sequencer (/api/outreach-enrol, /api/outreach-status, daily job).
# OUTREACH_ADMIN_SECRET=   # required. Enrol and status fail closed when unset.
# OUTREACH_SEND_LIVE=0     # 1 sends. Anything else logs the would-be send and records nothing.
# OUTREACH_DAILY_CAP=20    # max sends per London day. WhatsApp is also capped at 250/day.
# WHATSAPP_CONTENT_SID_DAY0=   # ContentSid for approved template tm_website_preview_v2
# WHATSAPP_CONTENT_SID_DAY3=   # approved template. Day 3 is outside the 24h window.
# WHATSAPP_CONTENT_SID_DAY10=  # approved template. Day 10 is outside the 24h window.

# Public checkout URL for success/cancel links (defaults to config checkoutBaseUrl or request host)
# CHECKOUT_BASE_URL=https://taylor-marriott.com/checkout
