# Discovery booking uses the Google Calendar API only — no Appointment Schedule / booking page URL.
# Optional: keep button copy in sync with server (Netlify: DISCOVERY_SLOT_MINUTES=30)
# VITE_DISCOVERY_SLOT_MINUTES=30

# --- Google Calendar API (Netlify + local .env for functions — not VITE_*) ---
# Which calendar to use: your main calendar email, "primary", or a dedicated outreach calendar ID.
# The site reads busy times here and creates 30-min events with Google Meet on book.
GOOGLE_CALENDAR_ID=

# Option A — OAuth (recommended for personal Gmail + Google Meet links)
# Web client: add redirect URI http://localhost:3333/oauth/callback then run:
#   node scripts/google-oauth-refresh-token.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Option B — Service account (share your calendar with the service account email, Make changes to events)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_IMPERSONATE=   # Workspace domain-wide delegation only

# Booking rules (optional)
# DISCOVERY_TIMEZONE=Europe/London
# DISCOVERY_SLOT_MINUTES=30
# DISCOVERY_HOUR_START=9
# DISCOVERY_HOUR_END=21
# DISCOVERY_HOUR_END_MINUTE=30
# DISCOVERY_WEEKDAYS=1,2,3,4,5,6,7
# DISCOVERY_MIN_NOTICE_HOURS=4
# DISCOVERY_HORIZON_DAYS=28
